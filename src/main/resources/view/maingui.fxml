<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="bp" prefHeight="760.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.MainguiController">
   <left>
      <!-- Menú lateral: las opciones se agregan desde el controlador según el perfil -->
      <VBox fx:id="sidebar" styleClass="sidebar">
         <children>
            <HBox fx:id="marcaBox" alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <StackPane fx:id="logo" styleClass="marca-logo" />
                  <VBox fx:id="marcaTextos" alignment="CENTER_LEFT">
                     <children>
                        <Label fx:id="lblApp" styleClass="brand-titulo" text="SysVentaRopa" />
                        <Label fx:id="lblAppSub" styleClass="brand-sub" text="Tienda de ropa" />
                     </children>
                  </VBox>
               </children>
               <VBox.margin><Insets bottom="14.0" left="4.0" /></VBox.margin>
            </HBox>
            <Button fx:id="btnInicio" maxWidth="Infinity" onAction="#irInicio" styleClass="menu-btn" text="Dashboard" />
            <ScrollPane fx:id="menuScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="menu-scroll" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="menuBox" spacing="3.0" />
               </content>
            </ScrollPane>
            <VBox fx:id="ajustesBox" styleClass="sidebar-ajustes">
               <children>
                  <Label fx:id="lblTema" styleClass="campo-label" text="TEMA" />
                  <ComboBox fx:id="cbxTema" maxWidth="Infinity" />
                  <Label fx:id="lblIdioma" styleClass="campo-label" text="IDIOMA" />
                  <ComboBox fx:id="cbxIdioma" maxWidth="Infinity" />
               </children>
               <VBox.margin><Insets top="10.0" /></VBox.margin>
            </VBox>
            <Button fx:id="btnSalir" maxWidth="Infinity" onAction="#cerrarSesion" styleClass="btn-salir" text="Cerrar sesión">
               <VBox.margin><Insets top="10.0" /></VBox.margin>
            </Button>
         </children>
      </VBox>
   </left>
   <top>
      <HBox styleClass="topbar">
         <children>
            <Button fx:id="btnColapsar" onAction="#alternarMenu" styleClass="btn-icono" />
            <VBox alignment="CENTER_LEFT">
               <children>
                  <Label fx:id="lblRuta" styleClass="topbar-ruta" text="SysVentaRopa" />
                  <Label fx:id="lblTitulo" styleClass="topbar-titulo" text="Dashboard" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox fx:id="fechaPill" styleClass="topbar-pill">
               <children>
                  <Label fx:id="lblFecha" text="" />
                  <Label fx:id="lblReloj" styleClass="reloj" text="00:00" />
               </children>
            </HBox>
            <Region styleClass="separador-v" />
            <StackPane styleClass="avatar">
               <children>
                  <Label fx:id="lblInicial" text="U" />
               </children>
            </StackPane>
            <VBox alignment="CENTER_LEFT">
               <children>
                  <Label fx:id="lblUsuario" styleClass="user-nombre" text="Usuario" />
                  <Label fx:id="lblPerfil" styleClass="user-perfil" text="Perfil" />
               </children>
            </VBox>
         </children>
      </HBox>
   </top>
   <center>
      <StackPane fx:id="contenido" styleClass="contenido" />
   </center>
</BorderPane>
